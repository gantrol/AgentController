{
  "name": "@agentcontroller/workspace",
  "private": true,
  "scripts": {
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/maintain.ps1 -Action Check",
    "check:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/maintain.ps1 -Action Check -RequireClean",
    "restore": "dotnet restore ./AgentController.sln",
    "build": "dotnet build ./AgentController.sln -c Debug",
    "build:debug": "dotnet build ./AgentController.sln -c Debug",
    "build:release": "dotnet build ./AgentController.sln -c Release",
    "build:controller:debug": "dotnet build ./app/AgentController.csproj -c Debug",
    "build:controller:release": "dotnet build ./app/AgentController.csproj -c Release",
    "build:micro:debug": "dotnet build ./virtual-micro/src/CodexMicro.DesktopHost/CodexMicro.DesktopHost.csproj -c Debug",
    "build:micro:release": "dotnet build ./virtual-micro/src/CodexMicro.DesktopHost/CodexMicro.DesktopHost.csproj -c Release",
    "build:deepseek-bridge": "pnpm --dir ./micro-bridge/DeepSeekHarness run build",
    "debug": "dotnet run --project ./app/AgentController.csproj -c Debug",
    "debug:controller": "dotnet run --project ./app/AgentController.csproj -c Debug",
    "debug:controller:dev": "dotnet run --project ./app/AgentController.csproj -c Debug -- --dev-instance",
    "debug:controller:background": "dotnet run --project ./app/AgentController.csproj -c Debug -- --background",
    "debug:micro": "dotnet run --project ./virtual-micro/src/CodexMicro.DesktopHost/CodexMicro.DesktopHost.csproj -c Debug",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-release.ps1",
    "release:controller": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-release.ps1",
    "release:controller:compact": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-release.ps1 -Compact",
    "release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-release.ps1",
    "release:verify:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-release.ps1 -IncludeCompact",
    "release:micro": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-micro.ps1 -Preset standard",
    "release:monitor": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-micro.ps1 -Preset monitor",
    "release:macos": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-macos.ps1",
    "export:micro:keypads": "dotnet run --project ./virtual-micro/tools/CodexMicro.AssetExporter/CodexMicro.AssetExporter.csproj -c Release -- ./virtual-micro/Assets/KeypadExports",
    "export:micro:lighting-pages": "dotnet run --project ./virtual-micro/tools/CodexMicro.AssetExporter/CodexMicro.AssetExporter.csproj -c Release -- --lighting-pages ./virtual-micro/Assets/LightingPageExports/RequestedScreens"
  }
}
