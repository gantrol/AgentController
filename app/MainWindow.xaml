<Window x:Class="CodexController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:CodexController.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:CodexController.Views"
        mc:Ignorable="d"
        Title="Agent Controller"
        Width="1220"
        Height="800"
        MinWidth="1060"
        MinHeight="690"
        MaxWidth="1440"
        MaxHeight="960"
        Icon="Assets/AgentController.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="{StaticResource Font.Ui}"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="26"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="CrystalShell"
            Margin="18"
            Padding="0"
            Background="{StaticResource Brush.Shell.WorkSurface}"
            BorderBrush="{StaticResource Brush.Shell.OuterCrystal}"
            BorderThickness="7"
            CornerRadius="28"
            Effect="{StaticResource Shadow.Window}">
        <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" MinHeight="26" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="14,0,10,0"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="34"
                                    Height="34"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0">
                                <views:ControllerIconView Margin="2"
                                                          Foreground="{StaticResource Brush.Text.Accent}" />
                            </Border>
                            <TextBlock Margin="10,0,0,0"
                                       Text="AGENT CONTROLLER"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       FontSize="{StaticResource Font.Size.Caption}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AppSubtitleText"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DeviceNavButton"
                                             GroupName="PrimaryNavigation"
                                             IsChecked="True"
                                             Style="{StaticResource Shell.NavIcon}"
                                             ToolTip="{loc:Loc nav.device}"
                                             AutomationProperties.Name="{loc:Loc nav.device}"
                                             Click="DeviceNavButton_Click">
                                    <ContentControl Style="{StaticResource Icon}" Content="{StaticResource Icon.Controller}"
                                                    Width="24" Height="24"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                                <RadioButton x:Name="ConfigNavButton"
                                             GroupName="PrimaryNavigation"
                                             Style="{StaticResource Shell.NavIcon}"
                                             ToolTip="{loc:Loc nav.configuration}"
                                             AutomationProperties.Name="{loc:Loc nav.configuration}"
                                             Click="ConfigNavButton_Click">
                                    <Image Width="24" Height="24"
                                           Source="{Binding AgentLogo, ElementName=ConfigPage}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </RadioButton>
                                <RadioButton x:Name="SettingsNavButton"
                                             GroupName="PrimaryNavigation"
                                             Style="{StaticResource Shell.NavIcon}"
                                             ToolTip="{loc:Loc nav.settings}"
                                             AutomationProperties.Name="{loc:Loc nav.settings}"
                                             Click="SettingsNavButton_Click">
                                    <ContentControl Style="{StaticResource Icon}" Content="{StaticResource Icon.Settings}"
                                                    Width="24" Height="24"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border Width="28"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    ToolTip="{Binding DataContext.ControllerStatusText, ElementName=DevicePage}">
                                <Ellipse x:Name="ControllerStatusDot"
                                         Width="7"
                                         Height="7">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsAgentStatusActive, ElementName=DevicePage}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Status.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Border>
                            <TextBlock x:Name="ControllerStatusText"
                                       Text="{Binding DataContext.AgentStatusText, ElementName=DevicePage}"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Margin="0,0,10,0" MaxWidth="180"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontSize="{StaticResource Font.Size.Caption}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <CheckBox x:Name="BridgeEnabledCheckBox"
                                      Margin="0,0,10,0"
                                      Style="{StaticResource Shell.Toggle}"
                                      ToolTip="{loc:Loc device.enable-bridge}"
                                      AutomationProperties.Name="{loc:Loc device.enable-bridge}"
                                      IsChecked="True"
                                      Checked="BridgeEnabledCheckBox_Changed"
                                      Unchecked="BridgeEnabledCheckBox_Changed" />
                            <Button Style="{StaticResource Shell.WindowButton}"
                                    Content="{StaticResource Icon.Window.Minimize}"
                                    ToolTip="{loc:Loc window.minimize}"
                                    Click="MinimizeButton_Click" />
                            <Button Style="{StaticResource Shell.CaptionButton.Close}"
                                    Content="{StaticResource Icon.Window.Close}"
                                    ToolTip="{loc:Loc window.close}"
                                    Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="14,4,14,8">
                        <views:DevicePageView x:Name="DevicePage"
                                              SidebarSelectionChanged="SidebarList_SelectionChanged"
                                              SidebarMouseDoubleClick="SidebarList_MouseDoubleClick"
                                              SidebarPreviewKeyDown="SidebarList_PreviewKeyDown" />

                        <views:ConfigPageView x:Name="ConfigPage"
                                              Visibility="Collapsed"
                                              AgentSettings="{Binding DataContext, ElementName=SettingsPage}"
                                              FullResetText="{Binding DataContext.FullResetExpirationText, ElementName=DevicePage}"
                                              FullResetToolTip="{Binding DataContext.FullResetExpirationToolTip, ElementName=DevicePage}"
                                              AgentTargetRequested="AgentTargetButton_Click" />

                        <views:SettingsPageView x:Name="SettingsPage"
                                                Visibility="Collapsed" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Ellipse x:Name="FooterPulse"
                                     Width="5"
                                     Height="5"
                                     Margin="0,0,0,0"
                                     VerticalAlignment="Center"
                                     ToolTip="{Binding Text, ElementName=FooterStatusText}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill"
                                                Value="{StaticResource Brush.Status.Idle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsControllerConnected, ElementName=DevicePage}"
                                                         Value="True">
                                                <Setter Property="Fill"
                                                        Value="{StaticResource Brush.Status.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="FooterControllerLiveBadge"
                                       Margin="6,0,0,0"
                                       Text="{Binding DataContext.ControllerLiveBadge, ElementName=DevicePage}"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="{StaticResource Font.Size.Caption}"
                                       FontWeight="Bold"
                                       ToolTip="{Binding Text, ElementName=FooterStatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource Brush.Status.Idle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsControllerConnected, ElementName=DevicePage}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource Brush.Status.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="FooterStatusText"
                                       Text="{loc:Loc status.loading-agent-data, Arg0=Codex}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="FooterVersionText"
                                   Grid.Column="2"
                                   Margin="0,0,20,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   FontSize="{StaticResource Font.Size.Caption}" />
                    </Grid>
                    <ResizeGrip Grid.Row="2" Width="20" Height="20"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                                Foreground="{StaticResource Brush.Text.Secondary}"
                                shell:WindowChrome.ResizeGripDirection="BottomRight"
                                AutomationProperties.Name="{loc:Loc window.resize}" />
        </Grid>
    </Border>
</Window>
