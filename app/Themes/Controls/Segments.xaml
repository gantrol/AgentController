<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:CodexController.Views">

    <SolidColorBrush x:Key="Brush.TabbedPanel.Fill" Color="#F9FBFA" />
    <SolidColorBrush x:Key="Brush.TabbedPanel.Border" Color="#C5D0CA" />
    <SolidColorBrush x:Key="Brush.TabbedPanel.DisabledBorder" Color="#DEE4E0" />

    <Style x:Key="Focus.Tab" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="6,3,6,5"
                            BorderBrush="{StaticResource Brush.Focus.Ring}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.SM}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment.Base" TargetType="RadioButton">
        <Setter Property="Height" Value="{StaticResource Control.H.SM}" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="180" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.SM}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource Brush.Bg.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource Brush.Accent.Soft}" />
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource Brush.Border.Accent}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource Brush.Text.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav.Segment"
           TargetType="RadioButton"
           BasedOn="{StaticResource Segment.Base}">
        <Setter Property="Height" Value="{StaticResource Control.H.LG}" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyLg}" />
    </Style>

    <Style x:Key="Tab.Base"
           TargetType="RadioButton"
           BasedOn="{StaticResource Segment.Base}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource Control.H.LG}" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Tab}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Semibold}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tab.Segment"
           TargetType="RadioButton"
           BasedOn="{StaticResource Tab.Base}" />

    <Style x:Key="Tab.Connected"
           TargetType="RadioButton"
           BasedOn="{StaticResource Tab.Base}">
        <Setter Property="Panel.ZIndex" Value="2" />
        <Setter Property="ToolTipService.Placement" Value="Bottom" />
        <Setter Property="ToolTipService.VerticalOffset" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverSurface"
                                Margin="4,0,4,4"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.MD}" />
                        <views:ConnectedTabOutline x:Name="SelectedOutline"
                                                   Fill="{StaticResource Brush.TabbedPanel.Fill}"
                                                   Stroke="{StaticResource Brush.TabbedPanel.Border}"
                                                   IsHitTestVisible="False"
                                                   Visibility="Collapsed" />
                        <Border Margin="4,0,4,4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Label"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverSurface"
                                    Property="Background"
                                    Value="{StaticResource Brush.Bg.Hover}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="HoverSurface" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SelectedOutline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource Brush.Text.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HoverSurface" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="SelectedOutline" Property="Stroke"
                                    Value="{StaticResource Brush.TabbedPanel.DisabledBorder}" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.5" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tab.SidebarScope"
           TargetType="RadioButton"
           BasedOn="{StaticResource Tab.Base}">
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="ToolTipService.Placement" Value="Bottom" />
        <Setter Property="ToolTipService.VerticalOffset" Value="6" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Surface" Margin="0,2,0,5" CornerRadius="{StaticResource Radius.SM}"
                                Background="{TemplateBinding Background}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Border x:Name="Indicator" Height="2" Margin="10,0" VerticalAlignment="Bottom"
                                Background="{StaticResource Brush.Accent}" CornerRadius="1" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.Bg.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Panel.ConnectedTab" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.TabbedPanel.Fill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.TabbedPanel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.LG}" />
        <Setter Property="Margin" Value="0,-1,0,0" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Panel.ZIndex" Value="1" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="180" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
    </Style>

    <Style x:Key="NavButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Height" Value="{StaticResource Control.H.LG}" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyLg}" />
    </Style>
</ResourceDictionary>
