<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{StaticResource Brush.Status.Idle}" />
    </Style>

    <Style x:Key="Badge.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Text.Status" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.EventLine" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <DataTemplate x:Key="Event.Row">
        <Grid Margin="0,3"
              Background="Transparent"
              Style="{StaticResource Tooltip.HitRegion}">
            <Grid.ToolTip>
                <StackPanel>
                    <TextBlock Text="{Binding Time}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding Text}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid.ToolTip>
            <TextBlock Style="{StaticResource Text.EventLine}"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center">
                <Run Text="{Binding Time, Mode=OneWay}"
                     FontFamily="{StaticResource Font.Mono}"
                     BaselineAlignment="Baseline" />
                <Run Text="&#x2003;" />
                <Run Text="{Binding Text, Mode=OneWay}"
                     BaselineAlignment="Baseline" />
            </TextBlock>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
