<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style x:Key="Sidebar.ScopeGlyph"
               TargetType="ContentControl">
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="21" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Viewbox Stretch="Uniform"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch">
                            <Grid Width="24" Height="24">
                                <Grid x:Name="PinnedTasksGlyph"
                                      Visibility="Collapsed">
                                    <Path Data="M 4,2 H 12 L 11,7 L 14,10 V 12 H 9.5 V 18 L 8,20 L 6.5,18 V 12 H 2 V 10 L 5,7 Z"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.45"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <Path Data="M 14.5,14 H 21.5 V 22 H 14.5 Z M 16.5,17 H 19.7 M 16.5,19.5 H 19.7"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.35"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>

                                <Grid x:Name="PinnedProjectsGlyph"
                                      Visibility="Collapsed">
                                    <Path Data="M 4,2 H 12 L 11,7 L 14,10 V 12 H 9.5 V 18 L 8,20 L 6.5,18 V 12 H 2 V 10 L 5,7 Z"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.45"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <Path Data="M 13.5,15 H 17 L 18.5,16.5 H 22 V 21.5 H 13.5 Z"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.35"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>

                                <Grid x:Name="ProjectsGlyph"
                                      Visibility="Collapsed">
                                    <Path Data="M 2.5,6.5 H 9 L 11,9 H 21.5 V 18.5 H 2.5 Z"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.55"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>

                                <Grid x:Name="ProjectlessTasksGlyph"
                                      Visibility="Collapsed">
                                    <Ellipse Width="3.5"
                                             Height="3.5"
                                             Margin="1.5,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Stroke="{TemplateBinding Foreground}"
                                             StrokeThickness="1.4" />
                                    <Path Data="M 7,3 H 15 L 19,7 V 21 H 7 Z M 15,3 V 7 H 19 M 10,11 H 16 M 10,15 H 16"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.45"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Grid>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="PinnedTasks">
                                <Setter TargetName="PinnedTasksGlyph"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="Tag" Value="PinnedProjects">
                                <Setter TargetName="PinnedProjectsGlyph"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Projects">
                                <Setter TargetName="ProjectsGlyph"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ProjectlessTasks">
                                <Setter TargetName="ProjectlessTasksGlyph"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<DataTemplate x:Key="Sidebar.Entry">
                            <StackPanel>
                            <TextBlock Text="{Binding SectionHeader}" Margin="2,10,0,8"
                                       Foreground="{StaticResource Brush.Text.Accent}" FontWeight="SemiBold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SectionHeader}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" Tag="Projects"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource Brush.Text.Accent}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl"
                                               BasedOn="{StaticResource Sidebar.ScopeGlyph}">
                                            <Setter Property="Width" Value="19" />
                                            <Setter Property="Height" Value="19" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProject}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <StackPanel Grid.Column="1"
                                            Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{StaticResource Font.Size.Body}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               FontSize="{StaticResource Font.Size.Caption}" />
                                </StackPanel>
                                <Viewbox Grid.Column="2"
                                         Width="14"
                                         Height="14"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         ToolTip="{Binding PinBadge}"
                                         AutomationProperties.Name="{Binding PinBadge}">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Path Data="M 7,2 H 17 L 15.5,9 L 19,12 V 14 H 13 V 21 L 12,23 L 11,21 V 14 H 5 V 12 L 8.5,9 Z"
                                          Fill="Transparent"
                                          Stroke="{StaticResource Brush.Text.Accent}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                                <Path Grid.Column="3" Data="M 4,2 L 10,8 L 4,14" Width="7" Height="12" Stretch="Uniform"
                                      Margin="4,0,0,0" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5"
                                      VerticalAlignment="Center" ToolTip="{Binding ActionHint}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProject}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                            </StackPanel>
                        </DataTemplate>
</ResourceDictionary>
