<UserControl x:Class="CodexController.Views.ControllerTutorialView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:CodexController.Views"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="420"
             d:DesignWidth="760">
    <UserControl.Resources>
        <Style x:Key="Tutorial.Artwork.Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Accent}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Width" Value="140" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="Tutorial.DPadDirection" TargetType="{x:Type views:ControllerInputButton}"
               BasedOn="{StaticResource Controller.Input}">
            <Setter Property="Width" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type views:ControllerInputButton}">
                        <Grid Background="Transparent">
                            <Path x:Name="Face" Data="M 8,12 H 28 V 40 H 8 Z"
                                  Fill="Transparent" Stroke="Transparent" StrokeThickness="1.5" />
                            <Path Data="M 14,23 L 18,19 L 22,23" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Border Width="16" Height="2" Margin="0,0,0,2" VerticalAlignment="Bottom"
                                    Background="{StaticResource Brush.Text.Accent}" CornerRadius="1"
                                    RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding HoldProgress, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Stroke" Value="{StaticResource Brush.Text.Accent}" />
                            </Trigger>
                            <Trigger Property="IsLinkedHighlighted" Value="True">
                                <Setter TargetName="Face" Property="Fill" Value="{StaticResource Brush.Accent.Soft}" />
                                <Setter TargetName="Face" Property="Stroke" Value="{StaticResource Brush.Border.Accent}" />
                            </Trigger>
                            <Trigger Property="IsInputPressed" Value="True">
                                <Setter TargetName="Face" Property="Fill" Value="{StaticResource Brush.Accent.Soft}" />
                                <Setter TargetName="Face" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Tutorial.DirectionalPad">
            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Ellipse Grid.RowSpan="2" Margin="3" Fill="{StaticResource Brush.Bg.Sunken}"
                         Stroke="{StaticResource Brush.Border.Strong}" StrokeThickness="1"
                         IsHitTestVisible="False" />
                <Path Grid.RowSpan="2" Data="M 32,12 H 52 V 32 H 72 V 52 H 52 V 72 H 32 V 52 H 12 V 32 H 32 Z"
                      Fill="{StaticResource Brush.Bg.Surface}" Stroke="{StaticResource Brush.Border.Strong}"
                      StrokeThickness="1" StrokeLineJoin="Round" IsHitTestVisible="False" />
                <views:ControllerInputButton DataContext="{Binding Directions[0]}" Input="{Binding Input}"
                                             Mode="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType={x:Type views:ControllerTutorialView}}}"
                                             Style="{StaticResource Tutorial.DPadDirection}"
                                             ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding AccessibleName}" />
                <views:ControllerInputButton Grid.Row="1" DataContext="{Binding Directions[1]}" Input="{Binding Input}"
                                             Mode="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType={x:Type views:ControllerTutorialView}}}"
                                             Style="{StaticResource Tutorial.DPadDirection}"
                                             ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding AccessibleName}"
                                             RenderTransformOrigin="0.5,0.5">
                    <views:ControllerInputButton.RenderTransform>
                        <RotateTransform Angle="180" />
                    </views:ControllerInputButton.RenderTransform>
                </views:ControllerInputButton>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Tutorial.ActionItem">
            <Grid Margin="2,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <views:ControllerInputButton x:Name="Key" Input="{Binding Input}" Mode="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType={x:Type views:ControllerTutorialView}}}"
                                             Style="{StaticResource Controller.Input}"
                                             ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}">
                    <StackPanel>
                        <Border Width="72" Height="Auto" MinHeight="28" Padding="0" Style="{StaticResource Overlay.PhysicalKey.Compact}">
                            <views:ControllerGlyphView Glyph="{Binding Glyph}" Foreground="{StaticResource Brush.Text.Primary}"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="{DynamicResource Font.Size.Label}" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Margin="0,6,0,0"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </views:ControllerInputButton>
                <views:ControllerJoystick x:Name="Stick" Visibility="Collapsed"
                                          Input="{Binding StickPressInput}" Content="{Binding Glyph}"
                                          Mode="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType={x:Type views:ControllerTutorialView}}}"
                                          Style="{StaticResource Controller.Joystick}"
                                          ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding AccessibleName}" />
                <ContentControl x:Name="DirectionalPad" Visibility="Collapsed" Focusable="False"
                                Content="{Binding}" HorizontalContentAlignment="Center" />
                <TextBlock x:Name="StickTitle" Grid.Row="1" Text="{Binding Title}"
                           Visibility="Collapsed" Margin="0,6,0,0"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsStick}" Value="True">
                    <Setter TargetName="Key" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Stick" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StickTitle" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirectionalPad}" Value="True">
                    <Setter TargetName="Key" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DirectionalPad" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DirectionalPad" Property="ContentTemplate" Value="{StaticResource Tutorial.DirectionalPad}" />
                    <Setter TargetName="StickTitle" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid MaxWidth="1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Columns="6"
                     Margin="20,0"
                     Panel.ZIndex="2">
            <RadioButton x:Name="OverviewTutorialButton"
                         GroupName="ControllerTutorialMode"
                         Style="{StaticResource Tab.Connected}"
                         Content="{Binding OverviewTabLabel}"
                         ToolTip="{Binding OverviewTabToolTip}"
                         AutomationProperties.Name="{Binding OverviewTabLabel}"
                         IsChecked="{Binding IsOverviewMode, Mode=OneWay}"
                         Command="{Binding SelectOverviewCommand}" />
            <RadioButton x:Name="ActionTutorialButton"
                         GroupName="ControllerTutorialMode"
                         Style="{StaticResource Tab.Connected}"
                         Content="{Binding ActionTabGlyph}"
                         ToolTip="{Binding ActionTabToolTip}"
                         AutomationProperties.Name="{Binding ActionTabLabel}"
                         IsChecked="{Binding IsActionMode, Mode=OneWay}"
                         Command="{Binding SelectActionCommand}" />
            <RadioButton x:Name="AgentTutorialButton"
                         GroupName="ControllerTutorialMode"
                         Style="{StaticResource Tab.Connected}"
                         Content="{Binding LeftShoulderGlyph}"
                         ToolTip="{Binding AgentTabToolTip}"
                         AutomationProperties.Name="{Binding AgentTabLabel}"
                         IsChecked="{Binding IsAgentMode, Mode=OneWay}"
                         Command="{Binding SelectAgentCommand}" />
            <RadioButton x:Name="TurnTutorialButton"
                         GroupName="ControllerTutorialMode"
                         Style="{StaticResource Tab.Connected}"
                         Content="{Binding RightTriggerGlyph}"
                         ToolTip="{Binding TurnTabToolTip}"
                         AutomationProperties.Name="{Binding TurnTabLabel}"
                         IsChecked="{Binding IsTurnMode, Mode=OneWay}"
                         Command="{Binding SelectTurnCommand}" />
            <RadioButton x:Name="CommandTutorialButton"
                         GroupName="ControllerTutorialMode"
                         Style="{StaticResource Tab.Connected}"
                         Content="{Binding RightShoulderGlyph}"
                         ToolTip="{Binding CommandTabToolTip}"
                         AutomationProperties.Name="{Binding CommandTabLabel}"
                         IsChecked="{Binding IsCommandMode, Mode=OneWay}"
                         Command="{Binding SelectCommandCommand}" />
            <RadioButton x:Name="StickPressTutorialButton"
                         GroupName="ControllerTutorialMode"
                         Style="{StaticResource Tab.Connected}"
                         Content="L3 / R3"
                         ToolTip="{Binding StickPressTabToolTip}"
                         AutomationProperties.Name="{Binding StickPressTabLabel}"
                         IsChecked="{Binding IsStickPressMode, Mode=OneWay}"
                         Command="{Binding SelectStickPressCommand}" />
        </UniformGrid>

        <Border Grid.Row="1"
                x:Name="TutorialFrame"
                Padding="8"
                Style="{StaticResource Panel.ConnectedTab}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="3*" MinWidth="288" MaxWidth="432" />
                </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0"
                     Margin="8,12,12,8"
                     MaxWidth="640"
                     VerticalAlignment="Center"
                     Stretch="Uniform">
                <Canvas Width="2104" Height="1298">
                    <views:ControllerArtworkView x:Name="ControllerArtwork"
                                                 Canvas.Left="28" Canvas.Top="28"
                                                 Width="2048" Height="1242"
                                                 TutorialMode="{Binding Mode}" />
                    <Canvas x:Name="Hotspots" Canvas.Left="28" Canvas.Top="28" Width="2048" Height="1242" />
                    <TextBlock Canvas.Left="334" Canvas.Top="103"
                               Text="{Binding LeftTriggerGlyph}"
                               Style="{StaticResource Tutorial.Artwork.Label}" />
                    <TextBlock Canvas.Left="418" Canvas.Top="212"
                               Text="{Binding LeftShoulderGlyph}"
                               Style="{StaticResource Tutorial.Artwork.Label}" />
                    <TextBlock Canvas.Left="1556" Canvas.Top="212"
                               Text="{Binding RightShoulderGlyph}"
                               Style="{StaticResource Tutorial.Artwork.Label}" />
                    <TextBlock Canvas.Left="1630" Canvas.Top="103"
                               Text="{Binding RightTriggerGlyph}"
                               Style="{StaticResource Tutorial.Artwork.Label}" />
                </Canvas>
            </Viewbox>

            <Border Grid.Column="1"
                    Margin="4,4,0,0"
                    Padding="10,0,0,0"
                    Background="Transparent"
                    BorderBrush="{StaticResource Brush.Divider.Crystal.Vertical}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Focusable="False">
                        <ItemsControl ItemsSource="{Binding LayoutItems}"
                                      ItemTemplate="{StaticResource Tutorial.ActionItem}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <views:TutorialActionsPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
                <Border x:Name="ContextHintBar" Grid.Row="1" Grid.ColumnSpan="2"
                        views:ContextHint.IsDisplay="True"
                        Margin="12,12,12,4" Padding="4,14,4,8" Height="112"
                        BorderBrush="{StaticResource Brush.Divider.Crystal.Horizontal}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="{Binding ActiveLayerText}"
                                   Margin="12,0,0,0" VerticalAlignment="Top"
                                   Foreground="{StaticResource Brush.Text.Accent}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLayerActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ContentControl Style="{StaticResource Icon}" Content="{StaticResource Icon.Info}"
                                        Margin="0,1,12,0" VerticalAlignment="Top"
                                        Foreground="{StaticResource Brush.Text.Secondary}" />
                        <ScrollViewer Grid.Column="1" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource Font.Size.Label}" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource Self}, Path=(views:ContextHint.Title)}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(views:ContextHint.Title)}" Value="">
                                                <Setter Property="Text" Value="{Binding ModeTitle}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource Self}, Path=(views:ContextHint.Description)}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(views:ContextHint.Title)}" Value="">
                                                <Setter Property="Text" Value="{Binding ModeDescription}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
