<UserControl x:Class="CodexController.Views.FullResetStatusView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="720"
             MinHeight="{StaticResource Control.H.MD}"
             Background="Transparent"
             VerticalContentAlignment="Center"
             Focusable="True"
             FocusVisualStyle="{StaticResource Focus.Ring}"
             GotKeyboardFocus="ShowDetailsOnKeyboardFocus"
             ToolTip="{Binding ToolTipText, ElementName=Root}"
             AutomationProperties.Name="{Binding Text, ElementName=Root}"
             AutomationProperties.HelpText="{Binding ToolTipText, ElementName=Root}">
    <UserControl.Style>
        <Style TargetType="UserControl"
               BasedOn="{StaticResource Tooltip.HitRegion}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasCredits, ElementName=Root}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <TextBlock x:Name="StatusText"
               IsHitTestVisible="False"
               Foreground="{StaticResource Brush.Text.Secondary}"
               FontFamily="{StaticResource Font.Ui}"
               FontSize="{StaticResource Font.Size.Caption}"
               TextTrimming="CharacterEllipsis"
               TextWrapping="NoWrap" />
</UserControl>
