<UserControl x:Class="CodexController.Views.DevicePageView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:CodexController.Localization"
             xmlns:views="clr-namespace:CodexController.Views"
             mc:Ignorable="d"
             d:DesignHeight="660"
             d:DesignWidth="1184">

<UserControl.Resources>
    <Geometry x:Key="Device.Sidebar.Collapse">M 3,4 H 21 V 20 H 3 Z M 15,4 V 20 M 7,9 L 10,12 L 7,15</Geometry>
    <Geometry x:Key="Device.Sidebar.Expand">M 3,4 H 21 V 20 H 3 Z M 15,4 V 20 M 10,9 L 7,12 L 10,15</Geometry>
    <DataTemplate x:Key="Device.VoiceFeedback">
        <Grid ToolTip="{Binding VoiceActionTitle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:ControllerGlyphView Glyph="{Binding VoiceGlyph}" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontSize="{DynamicResource Font.Size.Caption}" />
            <TextBlock Grid.Column="1" Text="{Binding VoiceActionTitle}"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Status}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVoiceRecording}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasVoiceError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Status.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>
</UserControl.Resources>

<Grid x:Name="DevicePage">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="0,0,14,0" views:ContextHint.IsScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <views:ContextHint.DefaultText>
            <MultiBinding StringFormat="{}{0}&#x0a;{1}">
                <Binding Path="Tutorial.ModeTitle" />
                <Binding Path="Tutorial.ModeDescription" />
            </MultiBinding>
        </views:ContextHint.DefaultText>
        <Border Style="{StaticResource Card.Plain}">
            <views:ControllerTutorialView x:Name="ControllerTutorial"
                                          DataContext="{Binding Tutorial}" />
        </Border>
        <StackPanel Grid.Row="1" Margin="16,0,16,0">
            <StackPanel Margin="0,8,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasComposerFeedback}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,0,0,4">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasComposerSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,12,0" Text="{loc:Loc composer.current-selection}"
                               Style="{StaticResource Text.Status}" />
                    <TextBlock Grid.Column="1" Text="{Binding RightModeValue}"
                               Style="{StaticResource Text.Status}"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                </Grid>
                <TextBlock Text="{Binding RightModeStatusText}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Status}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRightModeWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <ContentControl Margin="0,8,0,8" Focusable="False"
                            Content="{Binding}" ContentTemplate="{StaticResource Device.VoiceFeedback}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVoiceFeedback}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </StackPanel>
    </Grid>

    <Grid x:Name="SidebarHost" Grid.Column="1" Width="410" ClipToBounds="True">
    <Grid x:Name="SidebarContent" Width="410" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,36,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SidebarTitleText"
                               Text="{Binding SidebarTitle}"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Font.Size.BodyLg}"
                               FontWeight="SemiBold" />
                    <Grid Grid.Column="1"
                          Margin="16,0,0,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProjectDirectory}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SidebarProjectName}"
                                   ToolTip="{Binding SidebarProjectName}"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   FontSize="{StaticResource Font.Size.Caption}"
                                   FontWeight="SemiBold"
                                   MaxWidth="150"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Margin="7,0"
                                   Text="›"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   FontSize="{StaticResource Font.Size.Caption}" />
                        <TextBlock Grid.Column="2" Text="{Binding SidebarProjectFilterText}"
                                   FontSize="{StaticResource Font.Size.Caption}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Brush.Text.Secondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProjectTasksPinnedOnly}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource Brush.Text.Accent}" />
                                            <Setter Property="FontWeight"
                                                    Value="SemiBold" />
                                            <Setter Property="TextDecorations"
                                                    Value="Underline" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
                <Grid x:Name="SidebarTabStrip" Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                            Background="{StaticResource Brush.Border.Subtle}" IsHitTestVisible="False" />
                    <Button x:Name="SidebarTabsPrevious" Visibility="Collapsed"
                            Style="{StaticResource Button.Ghost}" Width="26" MinWidth="0" Padding="4"
                            AutomationProperties.Name="←"
                            Focusable="False" Click="SidebarTabsPrevious_Click">
                        <Path Data="M 8,2 L 2,8 L 8,14" Stroke="{StaticResource Brush.Text.Secondary}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <ScrollViewer x:Name="SidebarTabsScroll" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly" Focusable="False"
                                  ScrollChanged="SidebarTabsScroll_Changed"
                                  SizeChanged="SidebarTabsScroll_SizeChanged"
                                  PreviewMouseWheel="SidebarTabsScroll_MouseWheel">
                    <ItemsControl x:Name="SidebarTabs" ItemsSource="{Binding SidebarSections}"
                                  KeyboardNavigation.TabNavigation="Once"
                                  KeyboardNavigation.DirectionalNavigation="Contained">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="SidebarRoot"
                                             Style="{StaticResource Tab.SidebarScope}"
                                             Content="{Binding Name}"
                                             ToolTip="{Binding Name}"
                                             ToolTipService.ShowOnDisabled="True"
                                             AutomationProperties.Name="{Binding Name}"
                                             IsEnabled="{Binding CanNavigate}"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Loaded="SidebarSection_EnsureVisible"
                                             Checked="SidebarSection_EnsureVisible"
                                             GotKeyboardFocus="SidebarSection_EnsureVisible"
                                             Click="SidebarSection_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                    <Button x:Name="SidebarTabsNext" Grid.Column="2" Visibility="Collapsed"
                            Style="{StaticResource Button.Ghost}" Width="26" MinWidth="0" Padding="4"
                            AutomationProperties.Name="→"
                            Focusable="False" Click="SidebarTabsNext_Click">
                        <Path Data="M 2,2 L 8,8 L 2,14" Stroke="{StaticResource Brush.Text.Secondary}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
                <Border Grid.Row="2"
                        Padding="0,8,0,0"
                        Style="{StaticResource Card.Plain}">
                <ListBox x:Name="SidebarList"
                         Style="{StaticResource ListBox.Sidebar}" ItemTemplate="{StaticResource Sidebar.Entry}"
                         ItemsSource="{Binding SidebarEntries}"
                         SelectionChanged="SidebarList_SelectionChanged"
                         MouseDoubleClick="SidebarList_MouseDoubleClick"
                         PreviewKeyDown="SidebarList_PreviewKeyDown">

                </ListBox>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card.Plain}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{loc:Loc sidebar.recent-events}"
                               FontSize="{StaticResource Font.Size.BodyLg}"
                               FontWeight="SemiBold" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" MaxHeight="108"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                <ItemsControl x:Name="EventList" ItemTemplate="{StaticResource Event.Row}"
                              ItemsSource="{Binding RecentEvents}">

                </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
        <Button x:Name="SidebarToggle" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="4,8,4,0" Click="SidebarToggle_Click"
                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                    <Setter Property="ToolTip" Value="{loc:Loc device.collapse-sidebar}" />
                    <Setter Property="Content" Value="{StaticResource Device.Sidebar.Collapse}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded, ElementName=Root}" Value="False">
                            <Setter Property="ToolTip" Value="{loc:Loc device.expand-sidebar}" />
                            <Setter Property="Content" Value="{StaticResource Device.Sidebar.Expand}" />
                            <Setter Property="Background" Value="{StaticResource Brush.Accent.Soft}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Accent}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.ContentTemplate>
                <DataTemplate>
                    <ContentControl Style="{StaticResource Icon}" Content="{Binding}"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </DataTemplate>
            </Button.ContentTemplate>
        </Button>
    </Grid>
</Grid>
</UserControl>
