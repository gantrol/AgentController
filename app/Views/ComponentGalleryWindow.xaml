<Window x:Class="CodexController.Views.ComponentGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CodexController.Localization"
        Title="{loc:Loc settings.components}"
        Width="1280" Height="900" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Shell.WorkSurface}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{DynamicResource Font.Size.Body}"
        Foreground="{StaticResource Brush.Text.Primary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc settings.components}" VerticalAlignment="Center"
                       FontSize="{DynamicResource Font.Size.Display}" FontWeight="SemiBold" />
            <TextBlock x:Name="SampleCount" Margin="12,0,24,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Mono}"
                       Foreground="{StaticResource Brush.Text.Secondary}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
            <TextBlock x:Name="SearchLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" Width="200" TextChanged="SearchBox_TextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="WidthLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="PreviewWidthBox" Width="76" VerticalAlignment="Center"
                      SelectionChanged="PreviewWidthBox_SelectionChanged" />
            <Button x:Name="ResetButton" Margin="12,0,0,0"
                    Style="{StaticResource Shell.IconButton}"
                    Content="↺" Click="ResetButton_Click" />
            </StackPanel>
        </WrapPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="CategoryList" Margin="0,0,20,0"
                     Style="{StaticResource ListBox.Sidebar}"
                     SelectionChanged="CategoryList_SelectionChanged" />
            <ScrollViewer x:Name="GalleryScroll" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="SectionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="{Binding Name}" Margin="0,0,0,12"
                                           FontSize="{DynamicResource Font.Size.Title}"
                                           FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Samples}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding PreviewWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="0,0,12,12" Padding="16"
                                                    Background="{StaticResource Brush.Bg.Surface}"
                                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius.MD}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Key}" ToolTip="{Binding Key}"
                                                               Margin="0,0,0,16"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               FontSize="{DynamicResource Font.Size.Caption}"
                                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                                               TextWrapping="Wrap" />
                                                    <ContentControl Content="{Binding Preview}"
                                                                    HorizontalContentAlignment="Stretch" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
