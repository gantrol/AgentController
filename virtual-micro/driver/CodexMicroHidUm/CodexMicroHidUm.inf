[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ProviderName%
DriverVer=07/18/2026,1.0.0.0
CatalogFile=codexmicrohidum.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskDescription%,,,

[SourceDisksFiles]
CodexMicroHidUm.dll=1

[Manufacturer]
%ManufacturerName%=OpenAI,NTamd64.10.0...22000

[OpenAI.NTamd64.10.0...22000]
%DeviceDescription%=CodexMicroHidUm,Root\CodexMicroHidUm

[CodexMicroHidUm.NT]
CopyFiles=UserModeDriverCopy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[CodexMicroHidUm.NT.HW]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.HW
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.HW

[CodexMicroHidUm.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[CodexMicroHidUm.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[CodexMicroHidUm.NT.Wdf]
UmdfService="CodexMicroHidUm",CodexMicroHidUm_Install
UmdfServiceOrder=CodexMicroHidUm
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[CodexMicroHidUm_Install]
UmdfLibraryVersion=2.23.0
ServiceBinary="%13%\CodexMicroHidUm.dll"

[UserModeDriverCopy]
CodexMicroHidUm.dll

[Strings]
ProviderName="OpenAI"
ManufacturerName="OpenAI"
DiskDescription="Codex Micro Simulator Driver Installation Disk"
DeviceDescription="Codex Micro Simulator UMDF2 Virtual HID"
