                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <BlurEffect Radius="8" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="GlowWide" Style="{StaticResource AgentWideHalo}" Background="{TemplateBinding BorderBrush}" Opacity="0" />
                                <Border x:Name="Glow" Style="{StaticResource AgentNearHalo}" Background="{TemplateBinding BorderBrush}" Opacity="0" />
