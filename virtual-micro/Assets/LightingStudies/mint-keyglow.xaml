                        </Button>
                        <Grid x:Name="JoystickSurface" Grid.Row="0" Grid.Column="3" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="JoystickSeat" Margin="4" Background="Transparent" BorderThickness="0" CornerRadius="18">
                                <Grid>
                                    <Grid x:Name="JoystickCap" Width="67" Height="67" Background="Transparent" Cursor="SizeAll" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.Effect>
                                            <DropShadowEffect BlurRadius="5" Direction="270" ShadowDepth="3" Opacity="0.42" Color="#232624" />
                                        </Grid.Effect>
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="JoystickScale" CenterX="33.5" CenterY="33.5" />
                                                <TranslateTransform x:Name="JoystickTranslate" />
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Ellipse Stroke="#CC000000" StrokeThickness="1">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush Center="0.34,0.27" GradientOrigin="0.34,0.27" RadiusX="0.76" RadiusY="0.76">
                                                    <GradientStop Color="#FF50524F" Offset="0" />
                                                    <GradientStop Color="#FF363936" Offset="0.44" />
                                                    <GradientStop Color="#FF222422" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Margin="1" Fill="Transparent" Stroke="#1AFFFFFF" StrokeThickness="1" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Button x:Name="JoystickUp" Width="24" Height="24" Margin="0,-6,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="3" Style="{StaticResource JoystickDirectionButton}" Tag="0.75|up" />
                            <Button x:Name="JoystickLeft" Width="24" Height="24" Margin="-6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="3" Style="{StaticResource JoystickDirectionButton}" Tag="0.50|left" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Button.RenderTransform>
                            </Button>
                            <Button x:Name="JoystickRight" Width="24" Height="24" Margin="0,0,-6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="3" Style="{StaticResource JoystickDirectionButton}" Tag="0.00|right" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </Button.RenderTransform>
                            </Button>
                            <Button x:Name="JoystickDown" Width="24" Height="24" Margin="0,0,0,-6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Panel.ZIndex="3" Style="{StaticResource JoystickDirectionButton}" Tag="0.25|down" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <RotateTransform Angle="180" />
                                </Button.RenderTransform>
                            </Button>
                        </Grid>
                        <Button x:Name="AgentKey2" Grid.Row="1" Grid.Column="0" Width="96" Height="96" Margin="5" Tag="CurrentNoLight" Style="{StaticResource AgentKey}">
                            <Button.BorderBrush>
                                <SolidColorBrush Color="#FFFFFF" Opacity="1" />
                            </Button.BorderBrush>
                        </Button>
                        <Button x:Name="AgentKey3" Grid.Row="1" Grid.Column="1" Width="96" Height="96" Margin="5" Tag="Off" Style="{StaticResource AgentKey}">
                            <Button.BorderBrush>
                                <SolidColorBrush Color="#8DB5FF" Opacity="0" />
                            </Button.BorderBrush>
                        </Button>
                        <Button x:Name="AgentKey4" Grid.Row="1" Grid.Column="2" Width="96" Height="96" Margin="5" Tag="Off" Style="{StaticResource AgentKey}">
                            <Button.BorderBrush>
                                <SolidColorBrush Color="#8DB5FF" Opacity="0" />
                            </Button.BorderBrush>
                        </Button>
                        <Button x:Name="AgentKey5" Grid.Row="1" Grid.Column="3" Width="96" Height="96" Margin="5" Tag="Off" Style="{StaticResource AgentKey}">
                            <Button.BorderBrush>
                                <SolidColorBrush Color="#8DB5FF" Opacity="0" />
                            </Button.BorderBrush>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Canvas>
</Grid>
