                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                    <Border.Effect>
                                        <StaticResource ResourceKey="AgentKeyShadow" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="CurrentNoLight">
                                    <Setter TargetName="MintSeamLight" Property="Opacity" Value="{StaticResource MintPreviewIntensity}" />
                                    <Setter TargetName="MintCapReturn" Property="Opacity" Value="{StaticResource MintPreviewIntensity}" />
                                    <Setter TargetName="MintWellLight" Property="Opacity" Value="{StaticResource MintPreviewIntensity}" />
                                    <Setter TargetName="MintWellReturn" Property="Opacity" Value="{StaticResource MintPreviewIntensity}" />
                                    <Setter TargetName="CapInsetShadow" Property="Opacity" Value="0.25" />
                                    <Setter TargetName="FarShadow" Property="Background" Value="{StaticResource AgentWhiteLightFarShadowBrush}" />
                                    <Setter TargetName="Cap" Property="Effect" Value="{StaticResource AgentWhiteLightKeyShadow}" />
                                    <Setter TargetName="AgentWellHighlight" Property="Stroke" Value="{StaticResource PaperWhiteLightRecessRingBrush}" />
                                    <Setter TargetName="AgentGlyph" Property="Opacity" Value="{StaticResource OriginalCurrentDotOpacity}" />
                                    <Setter TargetName="CurrentSessionGlyph" Property="Opacity" Value="{StaticResource MintCurrentDotOpacity}" />
                                    <Setter TargetName="StatusCapWash" Property="Opacity" Value="0.18" />
                                    <Setter TargetName="StatusLightField" Property="Opacity" Value="0.52" />
                                    <Setter TargetName="StatusWellWash" Property="Opacity" Value="0.38" />
