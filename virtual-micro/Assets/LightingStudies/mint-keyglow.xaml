<?xml version='1.0' encoding='utf-8'?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="497" Height="271" Background="White" ClipToBounds="True" IsHitTestVisible="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
