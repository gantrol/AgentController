            <sys:Double x:Key="MintPreviewIntensity">1</sys:Double>
            <sys:Double x:Key="OriginalCurrentDotOpacity">0</sys:Double>
            <sys:Double x:Key="MintCurrentDotOpacity">1</sys:Double>
            <Color x:Key="CurrentSessionDotColor">#B9EFD2</Color>
            <SolidColorBrush x:Key="CurrentSessionDotBrush" Color="{StaticResource CurrentSessionDotColor}" />
            <SolidColorBrush x:Key="InkBrush" Color="#2F3438" />
