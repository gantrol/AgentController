                                                    <RadialGradientBrush Center="0.46,0.4" GradientOrigin="0.46,0.4" RadiusX="0.54" RadiusY="0.57">
                                                        <GradientStop Color="#00FAFFFC" Offset="0" />
                                                        <GradientStop Color="#08C8FBDD" Offset="0.4" />
                                                        <GradientStop Color="#2698EDC1" Offset="0.74" />
                                                        <GradientStop Color="#4481E9B2" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse x:Name="StatusWellWash" Width="76" Height="76" Fill="{TemplateBinding BorderBrush}" Opacity="0.40" />
                                            <Ellipse x:Name="AgentWellHighlight" Width="76" Height="76" Fill="Transparent" Stroke="{StaticResource PaperRecessRingBrush}" StrokeThickness="1.6" />
                                            <Ellipse x:Name="CurrentSessionRing" Width="82" Height="82" Stroke="#AA8F86B8" StrokeThickness="1.25" Opacity="0" IsHitTestVisible="False" />
                                            <Grid x:Name="AgentGlyph" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6">
                                                <Grid.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.38" Color="#685FAE" />
                                                </Grid.Effect>
                                                <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FF685FAE" />
                                            </Grid>
                                            <Ellipse x:Name="CurrentSessionGlyph" Width="18" Height="18" Fill="{StaticResource CurrentSessionDotBrush}" Stroke="#28939A96" StrokeThickness="0.8" Opacity="0" IsHitTestVisible="False">
