<Window x:Class="CodexMicro.Storybook.StorybookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexMicro.Desktop.Controls;assembly=AgentController.MicroSurface.Wpf"
        Title="Micro Storybook · 模拟数据"
        Width="900" Height="740" MinWidth="800" MinHeight="600"
        Background="#F5F7F4" Foreground="#253029"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#CBD6CE" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Micro Storybook / 额度旋钮" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="预览">
                <Grid Background="#EFF3EF">
                    <Grid Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="PreviewScale" ScaleX="0.75" ScaleY="0.75" />
                        </Grid.LayoutTransform>
                        <controls:QuotaKnob x:Name="PreviewKnob"
                                            FiveHourRemaining="61" WeeklyRemaining="42"
                                            ModelId="gpt-6-sol" ReasoningEffort="high" />
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="10,0,0,0" IsHitTestVisible="False">
                            <Ellipse Width="7" Height="7" Fill="#9EBFFF" Margin="0,0,0,4" />
                            <Ellipse Width="7" Height="7" Fill="#9EBFFF" Margin="0,0,0,4" />
                            <Ellipse Width="7" Height="7" Fill="#9EBFFF" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="情景" />
                    <ComboBox x:Name="ProfilePicker" SelectedIndex="0" SelectionChanged="Option_Changed" AutomationProperties.Name="额度窗口情景">
                        <ComboBoxItem Content="Plus" Tag="both" />
                        <ComboBoxItem Content="Pro" Tag="weekly" />
                    </ComboBox>
                    <StackPanel x:Name="FiveHourControls">
                        <DockPanel>
                            <TextBlock Text="五小时" />
                            <TextBlock x:Name="FiveHourValue" Text="61%" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="FiveHourSlider" Minimum="0" Maximum="100" Value="61"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                ValueChanged="Quota_ValueChanged" AutomationProperties.Name="五小时剩余百分比" />
                        <CheckBox x:Name="FiveHourUnknown" Content="未知" Checked="Option_Changed" Unchecked="Option_Changed" />
                    </StackPanel>
                    <DockPanel>
                        <TextBlock Text="周" />
                        <TextBlock x:Name="WeeklyValue" Text="42%" HorizontalAlignment="Right" />
                    </DockPanel>
                    <Slider x:Name="WeeklySlider" Minimum="0" Maximum="100" Value="42"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            ValueChanged="Quota_ValueChanged" AutomationProperties.Name="周剩余百分比" />
                    <CheckBox x:Name="WeeklyUnknown" Content="未知" Checked="Option_Changed" Unchecked="Option_Changed" />
                    <TextBlock Text="模型" />
                    <ComboBox x:Name="ModelPicker" SelectedIndex="1" SelectionChanged="Option_Changed" AutomationProperties.Name="模型">
                        <ComboBoxItem Content="5.6 Sol" Tag="gpt-5.6-sol" />
                        <ComboBoxItem Content="6 Sol" Tag="gpt-6-sol" />
                        <ComboBoxItem Content="5.6 Luna" Tag="gpt-5.6-luna" />
                        <ComboBoxItem Content="6 Luna" Tag="gpt-6-luna" />
                        <ComboBoxItem Content="未知" Tag="" />
                    </ComboBox>
                    <TextBlock Text="推理强度" />
                    <ComboBox x:Name="EffortPicker" SelectedIndex="2" SelectionChanged="Option_Changed" AutomationProperties.Name="推理强度">
                        <ComboBoxItem Content="Low" Tag="low" />
                        <ComboBoxItem Content="Medium" Tag="medium" />
                        <ComboBoxItem Content="High" Tag="high" />
                        <ComboBoxItem Content="XHigh" Tag="xhigh" />
                        <ComboBoxItem Content="Max" Tag="max" />
                        <ComboBoxItem Content="Ultra" Tag="ultra" />
                        <ComboBoxItem Content="未知" Tag="" />
                    </ComboBox>
                    <TextBlock Text="显示" />
                    <ComboBox x:Name="ModePicker" SelectedIndex="0" SelectionChanged="Option_Changed" AutomationProperties.Name="显示状态">
                        <ComboBoxItem Content="跟随指针" Tag="Auto" />
                        <ComboBoxItem Content="额度" Tag="Quota" />
                        <ComboBoxItem Content="Hover" Tag="Model" />
                    </ComboBox>
                    <CheckBox x:Name="Updating" Content="切换中" Checked="Option_Changed" Unchecked="Option_Changed" />
                    <TextBlock Text="面板缩放" />
                    <ComboBox x:Name="ScalePicker" SelectedIndex="0" SelectionChanged="Option_Changed" AutomationProperties.Name="面板缩放">
                        <ComboBoxItem Content="75%" Tag="0.75" />
                        <ComboBoxItem Content="100%" Tag="1" />
                        <ComboBoxItem Content="125%" Tag="1.25" />
                        <ComboBoxItem Content="150%" Tag="1.5" />
                        <ComboBoxItem Content="200%" Tag="2" />
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <GroupBox Grid.Row="2" Header="状态" Margin="0,20,0,0">
            <UniformGrid Rows="1" Columns="7">
                <controls:QuotaKnob DisplayMode="Quota" FiveHourRemaining="61" WeeklyRemaining="42" />
                <controls:QuotaKnob DisplayMode="Quota" FiveHourRemaining="100" WeeklyRemaining="100" />
                <controls:QuotaKnob DisplayMode="Quota" FiveHourRemaining="0" WeeklyRemaining="42" />
                <controls:QuotaKnob DisplayMode="Quota" />
                <controls:QuotaKnob DisplayMode="Model" FiveHourRemaining="61" WeeklyRemaining="42" ModelId="gpt-5.6-sol" ReasoningEffort="high" />
                <controls:QuotaKnob DisplayMode="Model" FiveHourRemaining="61" WeeklyRemaining="42" ModelId="gpt-6-sol" ReasoningEffort="ultra" />
                <controls:QuotaKnob DisplayMode="Quota" HasFiveHourWindow="False" WeeklyRemaining="42" />
            </UniformGrid>
        </GroupBox>
    </Grid>
</Window>
