{
  "schemaVersion": 1,
  "id": "deepseek-one-click",
  "displayName": "Codex Micro for DeepSeek Harness",
  "defaultHarnessId": "deepseek-harness",
  "bundledHarnesses": [
    "deepseek-harness"
  ],
  "firstRun": {
    "mode": "explicit-choice",
    "probeSavedEndpoint": true,
    "officialDefaultWebUrl": "http://127.0.0.1:3080/",
    "offerExistingHarness": true,
    "offerManagedSetup": true,
    "installBundledHarness": false,
    "detectHarnessCheckout": false,
    "startHarnessAfterInstall": true,
    "openHarnessAfterInstall": true
  },
  "managedSetup": {
    "distributionName": "CodexMicro-DeepSeek",
    "onlineDistribution": "Ubuntu-24.04",
    "linuxUser": "codexmicro",
    "defaultPort": 3080,
    "bundledPayload": "payload/deepseek-runtime.wsl"
  },
  "voice": {
    "defaultProvider": "system",
    "requireFirstUseTest": true,
    "autoSubmit": false,
    "advancedProviders": [
      "local-qwen",
      "remote-websocket"
    ],
    "localQwenStartMode": "keypad-start"
  },
  "surface": {
    "theme": "deepseek-soft-blue",
    "showOnlyBundledHarnessesInitially": true
  }
}
