<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AssemblyName>AgentController.MicroSurface.Wpf</AssemblyName>
    <RootNamespace>AgentController.MicroSurface.Wpf</RootNamespace>
    <Description>Non-activating Codex Micro surface hosted by Agent Controller.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MicroSurfaceController.cs" />
    <Compile Include="..\CodexMicro.Desktop\MainWindow.xaml.cs"
             Link="MicroSurfaceWindow.xaml.cs">
      <DependentUpon>MicroSurfaceWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="..\CodexMicro.Desktop\MicroSettingsWindow.xaml.cs"
             Link="MicroSettingsWindow.xaml.cs">
      <DependentUpon>MicroSettingsWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="..\CodexMicro.Desktop\MicroVoiceSettingsWindow.xaml.cs"
             Link="MicroVoiceSettingsWindow.xaml.cs">
      <DependentUpon>MicroVoiceSettingsWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="..\CodexMicro.Desktop\KeycapEditorWindow.xaml.cs"
             Link="KeycapEditorWindow.xaml.cs">
      <DependentUpon>KeycapEditorWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="..\CodexMicro.Desktop\DeepSeekSetupWindow.xaml.cs"
             Link="DeepSeekSetupWindow.xaml.cs">
      <DependentUpon>DeepSeekSetupWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="..\CodexMicro.Desktop\Controls\*.cs"
             Link="Controls\%(Filename)%(Extension)" />
    <Compile Include="..\CodexMicro.Desktop\Services\*.cs"
             Link="Services\%(Filename)%(Extension)" />
    <Page Include="..\CodexMicro.Desktop\MainWindow.xaml"
          Link="MicroSurfaceWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\CodexMicro.Desktop\MicroSettingsWindow.xaml"
          Link="MicroSettingsWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\CodexMicro.Desktop\MicroVoiceSettingsWindow.xaml"
          Link="MicroVoiceSettingsWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\CodexMicro.Desktop\KeycapEditorWindow.xaml"
          Link="KeycapEditorWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\CodexMicro.Desktop\DeepSeekSetupWindow.xaml"
          Link="DeepSeekSetupWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\CodexMicro.Desktop\App.xaml"
          Link="MicroSurfaceResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <!-- These XAML files live outside this project directory, so dotnet-watch
         needs them listed explicitly for reliable Dev-mode restarts. -->
    <Watch Include="..\CodexMicro.Desktop\MainWindow.xaml" />
    <Watch Include="..\CodexMicro.Desktop\MicroSettingsWindow.xaml" />
    <Watch Include="..\CodexMicro.Desktop\MicroVoiceSettingsWindow.xaml" />
    <Watch Include="..\CodexMicro.Desktop\KeycapEditorWindow.xaml" />
    <Watch Include="..\CodexMicro.Desktop\DeepSeekSetupWindow.xaml" />
    <Watch Include="..\CodexMicro.Desktop\App.xaml" />
    <Content Include="..\..\voice\start-qwen3-asr-stream.ps1;..\..\voice\qwen3-asr-stream-server.py"
             Link="voice\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
    <ProjectReference Include="..\CodexMicro.Protocol\CodexMicro.Protocol.csproj" />
    <ProjectReference Include="..\..\..\src\AgentController.MicroBroker\AgentController.MicroBroker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodexMicro.Desktop.Tests" />
    <InternalsVisibleTo Include="CodexMicro.AssetExporter" />
  </ItemGroup>

</Project>
