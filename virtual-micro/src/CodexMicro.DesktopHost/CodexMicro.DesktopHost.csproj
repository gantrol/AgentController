<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <DisableWinExeOutputInference Condition="'$(Configuration)' == 'Debug'">true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Debug'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Debug'">true</DebugSymbols>
    <DisableFastUpToDateCheck Condition="'$(Configuration)' == 'Debug'">true</DisableFastUpToDateCheck>
    <DebugType Condition="'$(Configuration)' != 'Debug'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' != 'Debug'">false</DebugSymbols>
    <AssemblyName>CodexMicro</AssemblyName>
    <RootNamespace>CodexMicro.DesktopHost</RootNamespace>
    <AssemblyTitle>Codex Micro Keypad</AssemblyTitle>
    <Product>Codex Micro Keypad</Product>
    <Description>Standalone Codex Micro keypad using the original WPF XAML.</Description>
    <Version>0.3.6</Version>
    <AssemblyVersion>0.3.6.0</AssemblyVersion>
    <FileVersion>0.3.6.0</FileVersion>
    <ApplicationIcon>..\..\Assets\CodexMicro.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows10.0.19041.0</_Parameter1>
    </AssemblyAttribute>
    <ProjectReference Include="..\AgentController.MicroSurface.Wpf\AgentController.MicroSurface.Wpf.csproj" />
    <ProjectReference Include="..\..\..\src\AgentController.MicroBroker\AgentController.MicroBroker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\voice\start-qwen3-asr-stream.ps1;..\..\voice\qwen3-asr-stream-server.py"
             Link="voice\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
