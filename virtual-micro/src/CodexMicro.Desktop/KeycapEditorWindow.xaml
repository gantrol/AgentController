<Window x:Class="CodexMicro.Desktop.KeycapEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexMicro.Desktop.Controls"
        Title="Edit keycap"
        Width="940"
        Height="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="EditorLine" Color="#FFE4E2DE" />
        <SolidColorBrush x:Key="EditorMuted" Color="#FF8B8E91" />
        <Style x:Key="EditorQuietButton" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#0D202224" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorPrimaryButton" TargetType="Button"
               BasedOn="{StaticResource EditorQuietButton}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF1E2022" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="KeycapItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="128" />
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="KeySurface"
                                Padding="{TemplateBinding Padding}"
                                Background="#FFF7F5F1"
                                BorderBrush="#FFFFFFFF"
                                BorderThickness="1.2"
                                CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="7"
                                                  Direction="270"
                                                  ShadowDepth="2"
                                                  Opacity="0.19"
                                                  Color="#FF5A5E61" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeySurface" Property="BorderBrush" Value="#FFB8D4FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="KeySurface" Property="Background" Value="#FFEAF2FF" />
                                <Setter TargetName="KeySurface" Property="BorderBrush" Value="#FF88B9FF" />
                                <Setter TargetName="KeySurface" Property="BorderThickness" Value="1.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="#FFFEFEFD"
                BorderBrush="#FFE0DFDC"
                BorderThickness="1"
                CornerRadius="26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26"
                                  Direction="270"
                                  ShadowDepth="7"
                                  Opacity="0.23"
                                  Color="#FF3F4346" />
            </Border.Effect>
            <Grid Margin="28,24,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="92" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>

                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="EditorTitleText"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#FF202224"
                                   Text="Edit keycap" />
                        <TextBlock x:Name="EditorSubtitleText"
                                   Margin="0,8,0,0"
                                   FontSize="16"
                                   Foreground="{StaticResource EditorMuted}"
                                   Text="Choose what appears on ACT07" />
                    </StackPanel>
                    <Button Width="38"
                            Height="38"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource EditorQuietButton}"
                            Click="CancelButton_Click">
                        <Path Width="12" Height="12"
                              Data="M 1,1 L 11,11 M 11,1 L 1,11"
                              Stroke="#FF55595D"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Height="50"
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource EditorLine}"
                        BorderThickness="1"
                        CornerRadius="13">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Data="M 8.5,1 A 7.5,7.5 0 1 1 8.5,16 A 7.5,7.5 0 1 1 8.5,1 M 14,14 L 20,20"
                              Stroke="#FF8C9093"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="15"
                                     Foreground="#FF25282B"
                                     TextChanged="SearchBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholderText"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="15"
                                       Foreground="{StaticResource EditorMuted}"
                                       Text="Search keycaps" />
                        </Grid>
                    </Grid>
                </Border>

                <ListBox x:Name="KeycapList"
                         Grid.Row="2"
                         Margin="0,12,0,8"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource KeycapItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="KeycapList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding Label}">
                                <controls:KeycapIcon Width="26"
                                                     Height="26"
                                                     HorizontalAlignment="Center"
                                                     KeycapId="{Binding IconId}"
                                                     IconBrush="#FF202224" />
                                <TextBlock Margin="0,11,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="13"
                                           Foreground="#FF17191B"
                                           Text="{Binding DisplayText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3"
                        Margin="0,4,0,0"
                        Padding="20,14"
                        Background="#FFFFFFFF"
                        BorderBrush="{StaticResource EditorLine}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AssignedTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FF24272A"
                                       Text="Assigned shortcut or skill" />
                            <TextBlock x:Name="AssignedDetailText"
                                       Margin="0,5,0,0"
                                       FontSize="12.5"
                                       Foreground="{StaticResource EditorMuted}"
                                       Text="Keycap default: Approve" />
                        </StackPanel>
                        <ComboBox x:Name="ActionCombo"
                                  Grid.Column="1"
                                  Width="310"
                                  Height="44"
                                  Margin="24,0,0,0"
                                  Padding="12,0"
                                  VerticalContentAlignment="Center"
                                  Background="#FFFAF9F7"
                                  BorderBrush="{StaticResource EditorLine}"
                                  FontSize="13" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <TextBlock x:Name="EditorStatusText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#FFB06B4F" />
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="CancelButton"
                                Margin="0,0,10,0"
                                Style="{StaticResource EditorQuietButton}"
                                Foreground="#FF888B8E"
                                Content="Cancel"
                                Click="CancelButton_Click" />
                        <Button x:Name="SaveButton"
                                Style="{StaticResource EditorPrimaryButton}"
                                Content="Save"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
